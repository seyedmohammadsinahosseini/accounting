# ==============================================================================
# Accounting Platform - Environment Configuration Template
# ==============================================================================

# Application & Storage Paths
ACCT_DATA_DIR=/app/data
ACCT_DB=/app/data/accounting.db
ACCT_BACKUP_DIR=/app/data/backups
ACCT_LOG_DIR=/app/data/logs

# API & Interactive Documentation (1 = enable Swagger /docs & ReDoc; 0 = disable)
ACCT_ENABLE_DOCS=1

# Session Security (idle hours before automatic token expiration)
ACCT_SESSION_HOURS=12

# Automated Hot Backup Engine (Consistent SQLite WAL Snapshots)
ACCT_BACKUP_ENABLED=1
ACCT_BACKUP_EVERY_HOURS=20
ACCT_BACKUP_KEEP=30

# Rate Limiting & Abuse Prevention
ACCT_RATE_LOGIN=10
ACCT_RATE_API=240
ACCT_IDEMPOTENCY_TTL_HOURS=24

# Cryptographic Field-Level Security (AES-256-GCM Vault)
# Set to 0 in production to enforce strict fail-closed encryption for PII
ACCT_ALLOW_PLAINTEXT_PII=0

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins (e.g., https://app.example.com). Empty = same-origin only.
ACCT_CORS_ORIGINS=

# Initial Bootstrap Administrator (Required when ACCT_DEMO_SEED=0 on a fresh DB)
# ACCT_BOOTSTRAP_ADMIN_USERNAME=admin
# ACCT_BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Development / Evaluation Mode (1 = seed demo chart of accounts & sample transactions)
ACCT_DEMO_SEED=1
