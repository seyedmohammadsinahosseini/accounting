[Unit]
Description=Create and verify an accounting database backup
After=agency-accounting.service

[Service]
Type=oneshot
User=agency-accounting
Group=agency-accounting
WorkingDirectory=/opt/agency-accounting
EnvironmentFile=/etc/agency-accounting.env
UMask=0077
ExecStart=/opt/agency-accounting/.venv/bin/python -m app.backup_cli
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agency-accounting
