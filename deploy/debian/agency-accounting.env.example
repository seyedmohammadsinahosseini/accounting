# Copy to /etc/agency-accounting.env and chmod 600 it. Never commit real values.
ACCT_DEMO_SEED=0
ACCT_DATA_DIR=/var/lib/agency-accounting
ACCT_DB=/var/lib/agency-accounting/accounting.db
ACCT_BACKUP_DIR=/var/lib/agency-accounting/backups
ACCT_LOG_DIR=/var/lib/agency-accounting/logs
ACCT_BACKUP_ENABLED=0
ACCT_BACKUP_EVERY_HOURS=24
ACCT_BACKUP_KEEP=30
ACCT_IDEMPOTENCY_TTL_HOURS=24
ACCT_SESSION_HOURS=8
ACCT_RATE_LOGIN=10
ACCT_RATE_API=240
ACCT_CORS_ORIGINS=
ACCT_ALLOW_PLAINTEXT_PII=0

# Required only on first startup with a brand-new database. Use a unique, strong secret.
# Remove these two lines from the file after the first successful startup and password change.
ACCT_BOOTSTRAP_ADMIN_USERNAME=admin
ACCT_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# Optional: comma-separated exact browser origins when the frontend is hosted elsewhere.
# ACCT_CORS_ORIGINS=https://accounting.example.com
